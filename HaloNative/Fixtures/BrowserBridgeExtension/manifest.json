{
  "manifest_version": 3,
  "name": "Halo Browser Bridge (Development Fixture)",
  "version": "0.1.0",
  "description": "Minimal, read-only Manifest V3 development extension for Halo Chromium Native Messaging bridge.",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
