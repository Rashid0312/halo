{
  "manifest_version": 3,
  "name": "Halo Browser Bridge (Development)",
  "version": "0.1.0",
  "description": "Connects Halo to Chrome. Halo authorizes each tab and approves every action; the extension acts only on Halo's verified requests.",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js"
  }
}
