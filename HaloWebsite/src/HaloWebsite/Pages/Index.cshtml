@page
@model IndexModel
@{
    ViewData["Title"] = "Halo AI — The Smarter Mac Assistant";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<!-- ══════════════════════════════════════════════
     SECTION 1 · HERO WITH FLUID AURORA MESH
════════════════════════════════════════════════ -->
<section class="hero" id="hero">
    <!-- GPU-Accelerated WebGL Mesh Gradient Canvas -->
    <div class="hero-canvas-container" id="heroCanvasContainer">
        <canvas id="gradient-canvas" class="gradient-canvas"></canvas>
        <div class="hero-frosted-overlay"></div>
    </div>

    <div class="hero-inner">
        <div class="hero-badge">
            <span class="badge-sparkle">✦</span>
            <span>Built natively for macOS 26+</span>
            <span class="badge-tag">Apple Silicon</span>
        </div>

        <h1 class="hero-headline">
            The Mac assistant<br>
            <span class="hero-gradient-text">Siri always should have been.</span>
        </h1>

        <p class="hero-sub">
            Voice-activated. AI-powered. Runs natively on your Mac.<br>
            Control apps, manage files, search the web — all hands-free.
        </p>

        <div class="hero-actions">
            <a href="/download" class="btn btn-primary btn-lg">
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="btn-icon">
                    <path d="M8 1a.5.5 0 0 1 .5.5v9.793l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 11.293V1.5A.5.5 0 0 1 8 1z"/>
                </svg>
                Download for Mac
            </a>
            <a href="#how-it-works" class="btn btn-glass btn-lg">See how it works</a>
        </div>

        <p class="hero-note">Free · No account required · Zero setup</p>

        <!-- ══════════════════════════════════════════════
             LIVING MACOS DESKTOP SHOWCASE (Authentic macOS 26)
        ════════════════════════════════════════════════ -->
        <div class="living-desktop-wrapper" id="livingDesktop">
            
            <!-- Authentic macOS Menu Bar -->
            <header class="mac-desktop-menubar" aria-label="macOS Menu Bar">
                <div class="menubar-left">
                    <span class="apple-logo"></span>
                    <span class="menubar-app-name" id="menubarActiveApp">Notes</span>
                    <span class="menubar-item hide-mobile">File</span>
                    <span class="menubar-item hide-mobile">Edit</span>
                    <span class="menubar-item hide-mobile">Format</span>
                    <span class="menubar-item hide-mobile">View</span>
                    <span class="menubar-item hide-mobile">Window</span>
                    <span class="menubar-item hide-mobile">Help</span>
                </div>
                <div class="menubar-right">
                    <!-- Mic in-use indicator -->
                    <span class="menubar-mic-indicator" title="Microphone Active">
                        <span class="mic-dot-pulse"></span>
                    </span>
                    <!-- System Icons -->
                    <svg class="menubar-sys-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" title="Wi-Fi">
                        <path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/>
                    </svg>
                    <svg class="menubar-sys-icon" viewBox="0 0 24 24" fill="currentColor" title="Battery 100%">
                        <rect x="2" y="7" width="16" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
                        <rect x="4" y="9" width="10" height="6" rx="1"/>
                        <path d="M20 11v2"/>
                    </svg>
                    <svg class="menubar-sys-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" title="Spotlight">
                        <circle cx="11" cy="11" r="7"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <span class="menubar-clock" id="menubarClock">Sun 18 Oct 00:11</span>

                    <!-- Menu Bar Halo Capsule (PanelDesign.swift) -->
                    <button type="button" class="menubar-halo-pill pill-active" id="menuBarHaloPill" aria-label="Toggle Halo AI Panel" title="Toggle Mercy">
                        <span class="pill-mesh-icon">❄</span>
                        <span class="pill-title" id="pillStatusText">"Mercy"</span>
                        <span class="pill-status-dot"></span>
                    </button>
                </div>
            </header>

            <!-- Desktop Staging Surface with macOS Sonoma Graphic Blue Wallpaper -->
            <div class="mac-desktop-surface" id="macDesktopSurface">
                
                <!-- macOS Sonoma Graphic Waveform Wallpaper Layer -->
                <div class="sonoma-wallpaper-layer" aria-hidden="true">
                    <div class="wave-glow wg-top"></div>
                    <div class="wave-glow wg-mid"></div>
                    <div class="wave-glow wg-accent"></div>
                    <svg class="wave-lines-svg" viewBox="0 0 1000 500" preserveAspectRatio="none">
                        <path d="M-50,260 C200,180 350,340 600,220 C850,100 950,280 1050,200 L1050,550 L-50,550 Z" fill="rgba(56, 189, 248, 0.22)" />
                        <path d="M-50,300 C150,220 400,380 650,260 C850,160 980,310 1050,270 L1050,550 L-50,550 Z" fill="rgba(14, 165, 233, 0.28)" />
                        <path d="M-50,340 C250,270 450,420 750,300 C920,220 990,340 1050,320 L1050,550 L-50,550 Z" fill="rgba(2, 132, 199, 0.35)" />
                    </svg>
                </div>

                <!-- Desktop Folder Icons (Visible on the right side) -->
                <div class="desktop-cloud-icons" aria-hidden="true">
                    <div class="desk-icon-item">
                        <div class="desk-folder-graphic">
                            <svg class="mac-folder-svg" viewBox="0 0 40 32" fill="none">
                                <path d="M2 7C2 4.79 3.79 3 6 3H14.5L18 7H34C36.21 7 38 8.79 38 11V25C38 27.21 36.21 29 34 29H6C3.79 29 2 27.21 2 25V7Z" fill="url(#fGrad1)"/>
                                <path d="M2 13C2 10.79 3.79 9 6 9H34C36.21 9 38 10.79 38 13V25C38 27.21 36.21 29 34 29H6C3.79 29 2 27.21 2 25V13Z" fill="url(#fFront1)"/>
                                <defs>
                                    <linearGradient id="fGrad1" x1="2" y1="3" x2="38" y2="29" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#0284c7"/>
                                        <stop offset="1" stop-color="#0369a1"/>
                                    </linearGradient>
                                    <linearGradient id="fFront1" x1="2" y1="9" x2="38" y2="29" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#38bdf8"/>
                                        <stop offset="1" stop-color="#0284c7"/>
                                    </linearGradient>
                                </defs>
                            </svg>
                            <span class="cloud-badge">☁</span>
                        </div>
                        <span class="desk-icon-label">halo</span>
                    </div>
                    <div class="desk-icon-item">
                        <div class="desk-folder-graphic">
                            <svg class="mac-folder-svg" viewBox="0 0 40 32" fill="none">
                                <path d="M2 7C2 4.79 3.79 3 6 3H14.5L18 7H34C36.21 7 38 8.79 38 11V25C38 27.21 36.21 29 34 29H6C3.79 29 2 27.21 2 25V7Z" fill="url(#fGrad2)"/>
                                <path d="M2 13C2 10.79 3.79 9 6 9H34C36.21 9 38 10.79 38 13V25C38 27.21 36.21 29 34 29H6C3.79 29 2 27.21 2 25V13Z" fill="url(#fFront2)"/>
                                <defs>
                                    <linearGradient id="fGrad2" x1="2" y1="3" x2="38" y2="29" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#0284c7"/>
                                        <stop offset="1" stop-color="#0369a1"/>
                                    </linearGradient>
                                    <linearGradient id="fFront2" x1="2" y1="9" x2="38" y2="29" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#38bdf8"/>
                                        <stop offset="1" stop-color="#0284c7"/>
                                    </linearGradient>
                                </defs>
                            </svg>
                            <span class="cloud-badge">☁</span>
                        </div>
                        <span class="desk-icon-label">Desktop</span>
                    </div>
                </div>

                <!-- Window: macOS Apple Notes.app (Rich Native Proportions) -->
                <div class="desktop-window win-notes" id="winNotes">
                    <div class="dwin-titlebar notes-titlebar">
                        <div class="traffic-lights">
                            <span class="light close" title="Close"></span>
                            <span class="light min" title="Minimize"></span>
                            <span class="light zoom" title="Zoom"></span>
                        </div>
                        <div class="notes-toolbar-tools">
                            <span class="notes-tool-ico" title="Sidebar toggle">⊞</span>
                            <span class="notes-tool-ico" title="Grid view">▦</span>
                            <span class="notes-tool-ico" title="Delete">🗑</span>
                            <span class="notes-tool-ico" title="New Note">✎</span>
                        </div>
                        <div class="notes-title-group">
                            <span class="notes-app-icon">📝</span>
                            <span class="dwin-title" id="notesTitle">Notes — Q4 Launch Strategy</span>
                        </div>
                        <span class="notes-icloud-badge">iCloud</span>
                    </div>

                    <div class="notes-split-view">
                        <!-- Folders & Note Cards Column -->
                        <div class="notes-sidebar-pane">
                            <div class="notes-folders-section">
                                <div class="notes-folder-item active">📁 Quick Notes <span class="folder-count">8</span></div>
                                <div class="notes-folder-item">📁 Architecture <span class="folder-count">5</span></div>
                                <div class="notes-folder-item">📁 Product Eng <span class="folder-count">12</span></div>
                            </div>
                            <div class="notes-card-list">
                                <div class="note-card-item active">
                                    <span class="nc-title">Q4 Launch Strategy</span>
                                    <span class="nc-date">Today at 9:41 AM</span>
                                    <span class="nc-snippet">Architecture targets for macOS 26+ native release...</span>
                                </div>
                                <div class="note-card-item">
                                    <span class="nc-title">DeepSeek V3 Inference</span>
                                    <span class="nc-date">Yesterday</span>
                                    <span class="nc-snippet">Local streaming engine with 184ms TTFT latency...</span>
                                </div>
                                <div class="note-card-item">
                                    <span class="nc-title">M4 Neural Engine</span>
                                    <span class="nc-date">Oct 16</span>
                                    <span class="nc-snippet">38 TOPS NPU acceleration for on-device voice model...</span>
                                </div>
                            </div>
                        </div>

                        <!-- Main Note Canvas -->
                        <div class="notes-canvas-pane">
                            <div class="notes-header-meta">
                                <h3 class="note-main-heading" id="notesMainHeading">Q4 Milestones &amp; Launch Checklist</h3>
                                <span class="note-timestamp" id="notesTimestamp">Edited today at 9:41 AM</span>
                            </div>
                            <p class="notes-lead">Native macOS release targets (Apple Silicon M-Series):</p>
                            
                            <ul class="notes-interactive-checklist" id="notesChecklist">
                                <li class="checklist-item done" id="checkItem1">
                                    <span class="chk-box">✓</span>
                                    <span class="chk-label">On-device speech analyzer &amp; Silero VAD tuned</span>
                                    <span class="chk-badge success">Ready</span>
                                </li>
                                <li class="checklist-item target" id="checkItem2">
                                    <span class="chk-box">○</span>
                                    <span class="chk-label">Architecture signoff &amp; security review: Oct 24</span>
                                    <span class="chk-badge warning">Oct 24</span>
                                </li>
                                <li class="checklist-item target" id="checkItem3">
                                    <span class="chk-box">○</span>
                                    <span class="chk-label">Internal dogfooding release: Nov 2nd</span>
                                    <span class="chk-badge info">Nov 2</span>
                                </li>
                                <li class="checklist-item target" id="checkItem4">
                                    <span class="chk-box">○</span>
                                    <span class="chk-label">Public Release (Apple Silicon): Nov 15th</span>
                                    <span class="chk-badge primary">Nov 15</span>
                                </li>
                            </ul>

                            <div class="notes-dynamic-append" id="notesDynamicAppend"></div>
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════
                     CLOSED STATE: Floating Mercy Capsule Widget (PanelDesign.swift)
                ════════════════════════════════════════════════ -->
                <button type="button" class="mercy-desktop-capsule" id="mercyDesktopCapsule" aria-label="Open Mercy Panel" title="Click to open Mercy">
                    <div class="capsule-icon-wrap">
                        <svg class="capsule-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
                            <path d="M8 8l8 8M16 8l-8 8"/>
                        </svg>
                    </div>
                    <span class="capsule-name">Mercy</span>
                    <span class="capsule-status-dot"></span>
                </button>

                <!-- ══════════════════════════════════════════════
                     OPEN STATE: Authentic Halo Native Panel (PanelDesign.swift)
                ════════════════════════════════════════════════ -->
                <div class="desktop-window halo-native-panel" id="haloLivingPanel">
                    
                    <!-- Panel Header: MERCY · Status · Menu · Pin · Retract -->
                    <div class="panel-native-header">
                        <div class="panel-header-left">
                            <span class="panel-glyph">⬡</span>
                            <span class="panel-logo-text">MERCY</span>
                        </div>
                        <div class="panel-header-right">
                            <button type="button" class="panel-tool-btn" id="panelMenuBtn" title="Menu">•••</button>
                            <button type="button" class="panel-tool-btn" id="panelPinBtn" title="Keep in corner">📌</button>
                            <button type="button" class="panel-tool-btn retract-btn" id="panelRetractBtn" title="Close into Capsule">›</button>
                        </div>
                    </div>

                    <!-- Panel Scrollable Body -->
                    <div class="panel-native-body">
                        
                        <!-- Live User Query Bubble -->
                        <div class="chat-row user-row">
                            <div class="chat-speech-bubble" id="haloUserText">
                                "Hey Mercy, summarize Notes and send confirmed dates to Alex on Slack."
                            </div>
                        </div>

                        <!-- Halo Assistant Reply Text -->
                        <div class="chat-row assistant-row">
                            <div class="assistant-speech-bubble" id="haloAssistantText">
                                <p class="assistant-p">Found <strong>Q4 Launch Strategy</strong> in Notes. Milestones are confirmed: Architecture review Oct 24, beta Nov 2nd, public launch Nov 15th.</p>
                                <p class="assistant-p muted">Drafted confirmation message for Slack. Approval required below:</p>
                            </div>
                        </div>

                        <!-- Activity Status Steps Card (Collapsible Accordion from PanelDesign.swift) -->
                        <div class="native-activity-card" id="nativeActivityCard">
                            <div class="activity-header" id="activityHeaderToggle" role="button" tabindex="0" title="Toggle steps">
                                <span class="activity-title" id="activityTitleText">Reading Notes.app &amp; preparing Slack draft</span>
                                <span class="activity-timer" id="activityTimerText">0.4s</span>
                                <span class="activity-chevron" id="activityChevron">⌃</span>
                            </div>
                            <div class="activity-steps-list" id="activityStepsList">
                                <div class="act-step done">
                                    <span class="step-icon">✓</span>
                                    <span>Read Notes.app: Q4 Launch Strategy</span>
                                    <span class="step-time">0.2s</span>
                                </div>
                                <div class="act-step done">
                                    <span class="step-icon">✓</span>
                                    <span>Extracted 3 launch milestones</span>
                                    <span class="step-time">0.3s</span>
                                </div>
                                <div class="act-step done">
                                    <span class="step-icon">✓</span>
                                    <span>Verified thread in Slack #product-eng</span>
                                    <span class="step-time">0.4s</span>
                                </div>
                            </div>
                        </div>

                        <!-- Tool Approval Card (Native Mac Security Model) -->
                        <div class="native-approval-card" id="haloApprovalCard">
                            <div class="approval-title">
                                <span class="approval-icon">🛡️</span>
                                <span>Approval Required: Send Slack Message</span>
                            </div>
                            <p class="approval-desc">
                                Send update to <strong>Alex Chen</strong> in <strong>#product-eng</strong>: "Milestones confirmed: Beta on Nov 2nd, Public Release Nov 15th."
                            </p>
                            <div class="approval-actions">
                                <button type="button" class="btn-approval-primary" id="btnApproveSend">Confirm &amp; Send</button>
                                <button type="button" class="btn-approval-secondary" id="btnCancelSend">Cancel</button>
                            </div>
                        </div>

                    </div>

                    <!-- Bottom Glass Composer Bar -->
                    <div class="panel-native-composer">
                        <button type="button" class="composer-mic-icon-btn" aria-label="Voice input">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                <path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4M8 23h8"/>
                            </svg>
                        </button>
                        <input type="text" id="panelInputComposer" class="composer-input" placeholder="Ask Mercy anything..." />
                        <button type="button" class="composer-send-btn" id="composerSendBtn" aria-label="Send message">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="12" y1="19" x2="12" y2="5"/>
                                <polyline points="5 12 12 5 19 12"/>
                            </svg>
                        </button>
                    </div>

                </div>

                <!-- ══════════════════════════════════════════════
                     macOS DOCK (Authentic Floating Frosted Glass Dock)
                ════════════════════════════════════════════════ -->
                <div class="macos-dock" aria-label="macOS Dock">
                    <div class="dock-app-item" title="Finder"><span class="dock-ico dock-finder">🙂</span></div>
                    <div class="dock-app-item" title="Messages"><span class="dock-ico dock-messages">💬</span><span class="dock-badge">4</span></div>
                    <div class="dock-app-item" title="Photos"><span class="dock-ico dock-photos">🌸</span></div>
                    <div class="dock-app-item" title="FaceTime"><span class="dock-ico dock-facetime">📹</span><span class="dock-badge">16</span></div>
                    <div class="dock-app-item dock-calendar-item" title="Calendar">
                        <div class="dock-cal">
                            <span class="cal-month">SUN</span>
                            <span class="cal-day">18</span>
                        </div>
                    </div>
                    <div class="dock-app-item is-running" title="Notes">
                        <span class="dock-ico dock-notes">📝</span>
                        <span class="dock-running-dot"></span>
                    </div>
                    <div class="dock-app-item" title="Chrome"><span class="dock-ico dock-chrome">🌐</span></div>
                    <div class="dock-app-item" title="Settings"><span class="dock-ico dock-settings">⚙️</span></div>
                    <div class="dock-app-item" title="Activity Monitor"><span class="dock-ico dock-activity">📈</span></div>
                    <div class="dock-app-item" title="Spotify"><span class="dock-ico dock-spotify">🎧</span></div>
                    <div class="dock-app-item" title="Mail"><span class="dock-ico dock-mail">✉️</span></div>
                    <div class="dock-app-item" title="Terminal"><span class="dock-ico dock-terminal">&gt;_</span></div>
                    <div class="dock-app-item" title="Safari"><span class="dock-ico dock-safari">🧭</span></div>
                    <div class="dock-app-item" title="VS Code"><span class="dock-ico dock-vscode">💻</span></div>
                    <div class="dock-app-item" title="Docker"><span class="dock-ico dock-docker">🐳</span></div>
                    <div class="dock-divider"></div>
                    <div class="dock-app-item" title="Trash"><span class="dock-ico dock-trash">🗑️</span></div>
                </div>

            </div>

            <!-- Interactive Voice Sandbox Controller Shelf -->
            <footer class="desktop-controls-shelf" aria-label="Interactive Controls">
                <div class="shelf-header">
                    <div class="shelf-title-group">
                        <span class="shelf-badge">Interactive Live Demo</span>
                        <span class="shelf-title">Click a voice instruction to see Mercy control macOS apps:</span>
                    </div>
                    <div class="shelf-view-toggle">
                        <button type="button" class="mode-toggle-btn active" id="btnToggleOpen" title="View with Mercy Panel Expanded">
                            <span>⬡ Panel Open</span>
                        </button>
                        <button type="button" class="mode-toggle-btn" id="btnToggleClosed" title="View with Mercy Retracted into Pill">
                            <span>⬭ Closed (Pill)</span>
                        </button>
                    </div>
                </div>
                <div class="shelf-chips">
                    <button type="button" class="desktop-prompt-chip active" data-scenario="notesSlack">
                        <span class="chip-icon">🎙️</span>
                        <span>"Summarize Notes &amp; send confirmed dates to Alex on Slack"</span>
                    </button>
                    <button type="button" class="desktop-prompt-chip" data-scenario="addChecklist">
                        <span class="chip-icon">🎙️</span>
                        <span>"Complete Architecture signoff &amp; add Nov release note"</span>
                    </button>
                    <button type="button" class="desktop-prompt-chip" data-scenario="researchM4">
                        <span class="chip-icon">🎙️</span>
                        <span>"Research M4 benchmarks and append to Notes"</span>
                    </button>
                    <button type="button" class="desktop-prompt-chip" data-scenario="draftSlack">
                        <span class="chip-icon">🎙️</span>
                        <span>"Draft #product-eng release update from Notes"</span>
                    </button>
                </div>
            </footer>

        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════
     SECTION 2 · FEATURES
════════════════════════════════════════════════ -->
<!-- ══════════════════════════════════════════════
     SECTION 2 · FEATURES & SIRI VS. HALO SHOWCASE
════════════════════════════════════════════════ -->
<!-- ══════════════════════════════════════════════
     SECTION 2 · CAPABILITIES & APPLE-STYLE BENTO SHOWCASE
════════════════════════════════════════════════ -->
<section class="features section-padded" id="features">
    <div class="section-header">
        <div class="section-eyebrow">Capabilities</div>
        <h2>Everything Siri can't do.</h2>
        <p>Halo understands your Mac, sees your screen, and executes real workflows across installed apps.</p>
    </div>

    <!-- ── VIGNETTE 1: The Siri Reality vs. The Halo Reality ── -->
    <div class="siri-vs-halo-vignette" id="siriComparison">
        <div class="vignette-header">
            <span class="vignette-tag">Side-by-Side Reality</span>
            <h3 class="vignette-title">A real Mac assistant vs. a web search redirect</h3>
            <p class="vignette-sub">Click a real voice instruction to compare what Siri does against what Halo executes on macOS:</p>
            
            <div class="vignette-prompt-chips">
                <button type="button" class="v-chip active" data-siri-prompt="notesSlack">
                    <span>💬 "Summarize Notes &amp; send to Alex on Slack"</span>
                </button>
                <button type="button" class="v-chip" data-siri-prompt="xcodeFix">
                    <span>🛠️ "Why is my Xcode build failing?"</span>
                </button>
                <button type="button" class="v-chip" data-siri-prompt="cleanDesktop">
                    <span>📁 "Organize loose screenshots on Desktop into Archive"</span>
                </button>
            </div>
        </div>

        <div class="vignette-cards-grid">
            
            <!-- Left: The Siri Reality (with Authentic Apple Siri Orb Logo) -->
            <div class="vignette-card siri-reality-card">
                <div class="v-card-top">
                    <div class="siri-logo-wrap">
                        <svg class="siri-logo-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Apple Siri Logo">
                            <defs>
                                <radialGradient id="siriBgGlow" cx="50%" cy="50%" r="50%">
                                    <stop offset="0%" stop-color="#3b1d60"/>
                                    <stop offset="70%" stop-color="#0b0818"/>
