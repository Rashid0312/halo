<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Halo AI — The smarter Mac assistant. Voice-powered, AI-driven, built natively for macOS." />
    <title>@ViewData["Title"] - Halo AI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://sfss.cdn-apple.com/2.0.0-beta.2/sf-symbol.js"></script>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
</head>
<body>

    <!-- ── Navigation ── -->
    <header class="nav-bar">
        <nav class="nav-inner">
            <a href="/" class="nav-logo">
                <svg class="logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle cx="16" cy="16" r="15" fill="#0066CC"/>
                    <path d="M10 22V10h3v5h6v-5h3v12h-3v-5h-6v5z" fill="white"/>
                </svg>
                <span>Halo AI</span>
            </a>
            <ul class="nav-links">
                <li><a href="/#features">Features</a></li>
                <li><a href="/#how-it-works">How It Works</a></li>
                <li><a href="/#screenshots">Screenshots</a></li>
                <li><a href="/changelog">Changelog</a></li>
            </ul>
            <a href="/download" class="nav-cta btn btn-primary">
                Download
                <svg class="btn-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 1a.5.5 0 0 1 .5.5v9.793l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 11.293V1.5A.5.5 0 0 1 8 1z"/>
                </svg>
            </a>
            <button class="nav-hamburger" aria-label="Toggle menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">
                <span></span><span></span><span></span>
            </button>
        </nav>
    </header>

    <!-- ── Page Content ── -->
    <main>
        @RenderBody()
    </main>

    <!-- ── Footer ── -->
    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <span class="footer-logo">Halo AI</span>
                <p>The smarter Mac assistant.<br>Built natively for Apple Silicon.</p>
            </div>
            <nav class="footer-links" aria-label="Footer navigation">
                <div class="footer-col">
                    <h4>Product</h4>
                    <a href="/#features">Features</a>
                    <a href="/#how-it-works">How It Works</a>
                    <a href="/changelog">Changelog</a>
                </div>
                <div class="footer-col">
                    <h4>Download</h4>
                    <a href="/download">macOS 26+ (Apple Silicon)</a>
                </div>
            </nav>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year Halo AI. macOS 26+ · Apple Silicon required.</p>
        </div>
    </footer>

    <script src="~/js/fluid-gradient.js" asp-append-version="true"></script>
    <script src="~/js/living-desktop.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
