// Usage: calendar-create.jxa <title> <start local ISO> <end local ISO> [calendar name] [notes]
function run(argv) {
  const [title, start, end, calName, notes] = argv;
  const Cal = Application("Calendar");
  const writable = Cal.calendars().filter((c) => c.writable());
  const cal = (calName && writable.find((c) => c.name().toLowerCase() === calName.toLowerCase())) || writable[0];
  if (!cal) throw new Error("no writable calendar");
  const props = { summary: title, startDate: new Date(start), endDate: new Date(end) };
  if (notes) props.description = notes;
  cal.events.push(Cal.Event(props));
  return JSON.stringify({ ok: true, calendar: cal.name() });
}
