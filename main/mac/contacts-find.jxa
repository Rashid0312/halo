// Usage: contacts-find.jxa <name>
// Prints JSON [{ name, phones: [{label, value}], emails: [{label, value}] }] (max 10).
function run(argv) {
  const q = (argv[0] || "").trim();
  if (!q) return "[]";
  const Contacts = Application("Contacts");
  const seen = {};
  const people = [];
  for (const field of ["name", "nickname"]) {
    for (const p of Contacts.people.whose({ [field]: { _contains: q } })()) {
      const id = p.id();
      if (seen[id]) continue;
      seen[id] = true;
      people.push(p);
      if (people.length >= 10) break;
    }
  }
  const clean = (l) => (l || "").replace(/^_\$!<|>!\$_$/g, "");
  return JSON.stringify(
    people.map((p) => ({
      name: p.name(),
      phones: p.phones().map((x) => ({ label: clean(x.label()), value: x.value() })),
      emails: p.emails().map((x) => ({ label: clean(x.label()), value: x.value() })),
    })),
  );
}
