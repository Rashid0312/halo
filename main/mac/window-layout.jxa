// Usage: window-layout.jxa '<json>'
//   { "placements": [{ "app": "/Applications/Google Chrome.app", "position": "right", "screen": "external" }] }
// Puts each app's main window on a screen region and reports where it really
// ended up. Needs Accessibility (System Events).
//
// What makes this work where a quick script doesn't:
//   - real screens from NSScreen (Finder's "desktop bounds" is all screens merged)
//   - the usable area of each screen (no menu bar or Dock)
//   - leaves native full screen first (full-screen windows can't be moved)
//   - the app's real window (AXStandardWindow), not toolbars or popups
//   - checks the result instead of trusting "ok"
ObjC.import("AppKit");
ObjC.import("CoreGraphics");

const REGIONS = {
  left: [0, 0, 1 / 2, 1],
  right: [1 / 2, 0, 1 / 2, 1],
  top: [0, 0, 1, 1 / 2],
  bottom: [0, 1 / 2, 1, 1 / 2],
  "left-third": [0, 0, 1 / 3, 1],
  "center-third": [1 / 3, 0, 1 / 3, 1],
  "right-third": [2 / 3, 0, 1 / 3, 1],
  "left-two-thirds": [0, 0, 2 / 3, 1],
  "right-two-thirds": [1 / 3, 0, 2 / 3, 1],
  "top-left": [0, 0, 1 / 2, 1 / 2],
  "top-right": [1 / 2, 0, 1 / 2, 1 / 2],
  "bottom-left": [0, 1 / 2, 1 / 2, 1 / 2],
  "bottom-right": [1 / 2, 1 / 2, 1 / 2, 1 / 2],
  maximize: [0, 0, 1, 1],
  center: [0.15, 0.1, 0.7, 0.8],
};

/** Screens in System Events coordinates (top-left origin, y down from the main screen's top). */
function screens() {
  const list = $.NSScreen.screens;
  const mainHeight = list.objectAtIndex(0).frame.size.height;
  const out = [];
  for (let i = 0; i < list.count; i++) {
    const s = list.objectAtIndex(i);
    const id = ObjC.unwrap(s.deviceDescription.objectForKey("NSScreenNumber"));
    const f = s.frame;
    const v = s.visibleFrame;
    out.push({
      name: ObjC.unwrap(s.localizedName),
      builtin: Boolean($.CGDisplayIsBuiltin(id)),
      main: i === 0,
      frame: { x: f.origin.x, y: mainHeight - (f.origin.y + f.size.height), w: f.size.width, h: f.size.height },
      area: { x: v.origin.x, y: mainHeight - (v.origin.y + v.size.height), w: v.size.width, h: v.size.height },
    });
  }
  return out;
}

const contains = (r, x, y) => x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h;
const screenAt = (all, x, y) => all.find((s) => contains(s.frame, x, y)) ?? all[0];

/** "laptop", "external", "other", "main", a name ("philips"), or "" (keep). */
function pickScreen(all, wanted, current) {
  const q = String(wanted ?? "").toLowerCase().trim();
  if (!q || q === "same" || q === "current") return current;
  if (/laptop|built.?in|macbook|mac screen|this mac|retina|small/.test(q)) return all.find((s) => s.builtin) ?? current;
  if (/other|second/.test(q)) return all.find((s) => s !== current) ?? current;
  if (/main|primary/.test(q)) return all.find((s) => s.main);
  if (/extern|monitor|big|wide|display/.test(q)) return all.find((s) => !s.builtin) ?? current;
  return all.find((s) => s.name.toLowerCase().includes(q)) ?? null;
}

const fullScreen = (w) => {
  try {
    return w.attributes.byName("AXFullScreen").value();
  } catch (e) {
    return false;
  }
};

/**
 * The app's real window (AXStandardWindow, not toolbars or popups), referred to
 * by index: titles change (Terminal's spinner), which breaks name references.
 */
function mainWindow(proc) {
  const n = proc.windows.length;
  for (let i = 0; i < n; i++) {
    try {
      if (proc.windows[i].subrole() === "AXStandardWindow") return proc.windows[i];
    } catch (e) {}
  }
  return null;
}

function run(argv) {
  const { placements } = JSON.parse(argv[0]);
  const se = Application("System Events");
  const all = screens();
  const results = [];
  let shared = null; // placements without a screen follow the first one's screen

  for (const p of placements) {
    const r = { app: p.app, position: p.position };
    results.push(r);
    try {
      const region = REGIONS[p.position];
      if (!region && p.position !== "keep") throw new Error(`unknown position "${p.position}"`);
      const app = Application(p.app);
      const bundle = app.id();
      r.app = app.name();
      app.activate(); // also switches to its Space (needed for full-screen windows)
      let proc = null;
      let w = null;
      for (let i = 0; i < 50 && !w; i++) {
        proc = se.processes.whose({ bundleIdentifier: bundle })[0];
        try {
          w = mainWindow(proc);
        } catch (e) {}
        if (!w) delay(0.1);
      }
      if (!w) throw new Error("it has no open window");

      if (fullScreen(w)) {
        w.attributes.byName("AXFullScreen").value = false;
        for (let i = 0; i < 40 && fullScreen(mainWindow(proc)); i++) delay(0.1);
        delay(0.9); // the exit animation
        w = mainWindow(proc);
        r.leftFullScreen = true;
      }
      try {
        if (w.attributes.byName("AXMinimized").value()) w.attributes.byName("AXMinimized").value = false;
      } catch (e) {}

      const [x0, y0] = w.position();
      const [w0, h0] = w.size();
      const current = screenAt(all, x0 + w0 / 2, y0 + Math.min(h0 / 2, 50));
      const target = p.screen ? pickScreen(all, p.screen, current) : shared ?? current;
      if (!target) throw new Error(`no screen matches "${p.screen}"`);
      shared ??= target;

      const a = target.area;
      let want;
      if (p.position === "keep") {
        // Same place relative to the screen, on the target screen.
        const c = current.area;
        const fx = (x0 - c.x) / c.w, fy = (y0 - c.y) / c.h, fw = Math.min(1, w0 / c.w), fh = Math.min(1, h0 / c.h);
        want = { x: a.x + Math.max(0, Math.min(fx, 1 - fw)) * a.w, y: a.y + Math.max(0, Math.min(fy, 1 - fh)) * a.h, w: fw * a.w, h: fh * a.h };
      } else {
        want = { x: a.x + region[0] * a.w, y: a.y + region[1] * a.h, w: region[2] * a.w, h: region[3] * a.h };
      }
      want = { x: Math.round(want.x), y: Math.round(want.y), w: Math.round(want.w), h: Math.round(want.h) };
      // Position, size, position again: crossing screens can clamp the size the first time.
      w.position = [want.x, want.y];
      w.size = [want.w, want.h];
      w.position = [want.x, want.y];
      delay(0.25);

      const [x, y] = w.position();
      const [width, height] = w.size();
      r.screen = target.builtin ? `${target.name} (laptop)` : `${target.name} (external)`;
      r.ok = Math.abs(x - want.x) <= 40 && Math.abs(y - want.y) <= 40 && Math.abs(width - want.w) <= 60 && Math.abs(height - want.h) <= 60;
      if (!r.ok) r.note = `asked for ${want.w}×${want.h} at ${want.x},${want.y}, got ${width}×${height} at ${x},${y} (the app may limit its size)`;
    } catch (e) {
      r.ok = false;
      r.error = String(e.message ?? e);
    }
  }
  return JSON.stringify({
    screens: all.map((s) => `${s.name}${s.builtin ? " (laptop)" : " (external)"}: ${s.frame.w}×${s.frame.h}`),
    results,
  });
}
