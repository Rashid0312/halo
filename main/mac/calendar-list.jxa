// Usage: calendar-list.jxa <from YYYY-MM-DD> <days>
// Prints JSON [{title, start, end, allDay, calendar, location}] sorted by start.
// Note: Calendar scripting only returns the first instance of recurring events.
function run(argv) {
  const [y, m, d] = argv[0].split("-").map(Number);
  const from = new Date(y, m - 1, d);
  const to = new Date(from);
  to.setDate(to.getDate() + Math.max(1, Number(argv[1]) || 1));
  const Cal = Application("Calendar");
  const out = [];
  for (const cal of Cal.calendars()) {
    const events = cal.events.whose({ _and: [{ startDate: { _greaterThan: from } }, { startDate: { _lessThan: to } }] })();
    for (const e of events) {
      out.push({
        title: e.summary(),
        start: e.startDate().toString(),
        end: e.endDate().toString(),
        allDay: e.alldayEvent(),
        calendar: cal.name(),
        location: e.location() || "",
      });
    }
  }
  out.sort((a, b) => new Date(a.start) - new Date(b.start));
  return JSON.stringify(out);
}
