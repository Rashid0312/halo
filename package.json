{
  "name": "mercy",
  "productName": "Mercy",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "eval": "electron scripts/eval.mjs",
    "models": "node scripts/fetch-models.mjs",
    "touchbar": "node scripts/build-touchbar.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "npm run models && npm run touchbar && node scripts/dist.mjs"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.22.0"
  },
  "description": "Mercy — a friendly AI sidekick for your Mac.",
  "author": "Abdirashiid Sammantar",
  "repository": "https://github.com/Rashid0312/mercy",
  "build": {
    "appId": "app.mercy",
    "productName": "Mercy",
    "copyright": "Copyright © 2026 Abdirashiid Sammantar",
    "files": [
      "main/**",
      "preload/**",
      "renderer/**",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "main/mac/**",
      "node_modules/sherpa-onnx-*/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      },
      {
        "from": "native/touchbar/mercy-touchbar",
        "to": "mercy-touchbar"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Mercy listens for “Hey Mercy” and to what you ask her.",
        "NSAppleEventsUsageDescription": "Mercy controls the apps you ask her to — Calendar, Reminders, Notes, Messages and more."
      }
    },
    "dmg": {
      "title": "Mercy ${version}",
      "artifactName": "Mercy-${version}-${arch}.${ext}"
    },
    "afterPack": "build/after-pack.cjs",
    "directories": {
      "buildResources": "build"
    }
  }
}
